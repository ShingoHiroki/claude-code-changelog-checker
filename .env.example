# さくらのAI Engine のアカウントトークン（リリースノートの翻訳に必要）
SAKURA_AI_TOKEN=

# GitHub Personal Access Token（GitHub Releases API のレート制限緩和用。省略可）
GITHUB_TOKEN=

# Discord チャンネルの Webhook URL
DISCORD_WEBHOOK_URL=

# Slack チャンネルの Webhook URL（省略可。設定時のみ通知）
SLACK_WEBHOOK_URL=

# GitHub Pages サイトのURL（通知内のリンク用。省略可）
# GitHub Actions 上では GITHUB_REPOSITORY から自動導出されるため設定不要。
# ローカル実行時に通知へサイトリンクを含めたい場合のみ設定する。
SITE_URL=

# ドライラン（true にすると Discord/Slack に投稿せず stdout に出力）
DRY_RUN=
